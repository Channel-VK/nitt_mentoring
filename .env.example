DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
JWT_KEY="generate_with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
BCRYPT_SALT=12
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# SendGrid SMTP Configuration (for password reset emails)
# Sign up at https://sendgrid.com/free/ and create API key
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="SG.your-sendgrid-api-key-here"
EMAIL_FROM="your-verified-email@gmail.com"